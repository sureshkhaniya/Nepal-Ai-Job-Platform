# Application
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nepal_ai_jobs

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Authentication
SESSION_SECRET=replace-with-a-long-random-development-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Nepal SMS OTP provider
SMS_PROVIDER=
SMS_API_BASE_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Object storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# AI
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# eSewa - configure UAT values locally; never commit real merchant secrets
ESEWA_ENV=uat
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
ESEWA_SUCCESS_URL=http://localhost:4000/v1/payments/esewa/success
ESEWA_FAILURE_URL=http://localhost:4000/v1/payments/esewa/failure

# Observability
LOG_LEVEL=debug
